:root { --azul:#1f4e79; --azul2:#2f6fb5; --gris:#5b6472; --borde:#cfd6df; --fondo:#f4f6f9; --ok:#1e7a3c; --alerta:#b26a00; }

@page {
  size: A4;
  margin: 17mm 15mm 18mm 15mm;
  @bottom-left  { content: "Seguridad Informática · De servidor vulnerable a servidor protegido"; font: 8pt "Segoe UI", Arial, sans-serif; color: #777; }
  @bottom-right { content: "Pág. " counter(page) " de " counter(pages); font: 8pt "Segoe UI", Arial, sans-serif; color: #777; }
}
@page :first { margin: 0; @bottom-left { content: none; } @bottom-right { content: none; } }

* { box-sizing: border-box; }
html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body { font: 10.5pt/1.45 "Segoe UI", Calibri, Arial, sans-serif; color: #1b1f24; margin: 0; }

/* Portada */
.portada { height: 296mm; padding: 32mm 24mm 20mm; background: linear-gradient(180deg, #f4f8fc 0%, #ffffff 55%); border-left: 14mm solid var(--azul); page-break-after: always; position: relative; }
.portada .curso { font-size: 12pt; letter-spacing: .08em; text-transform: uppercase; color: var(--azul2); font-weight: 600; }
.portada h1.titulo { font-size: 31pt; line-height: 1.12; color: var(--azul); border: 0; margin: 10mm 0 4mm; break-before: auto; padding: 0; }
.portada .sub { font-size: 14pt; color: var(--gris); margin-bottom: 22mm; }
.portada .bloque { margin-bottom: 8mm; }
.portada .bloque .et { font-size: 9pt; text-transform: uppercase; letter-spacing: .08em; color: var(--gris); }
.portada .bloque .val { font-size: 13pt; }
.portada .pie { position: absolute; left: 24mm; right: 14mm; bottom: 16mm; font-size: 9pt; color: var(--gris); border-top: 1px solid var(--borde); padding-top: 4mm; }

/* Titulos */
h1 { font-size: 17pt; color: var(--azul); border-bottom: 2px solid var(--azul); padding-bottom: 3px; margin: 0 0 10pt; break-before: page; break-after: avoid; }
h1.sinsalto { break-before: auto; margin-top: 18pt; }
h2 { font-size: 13pt; color: #17324d; margin: 16pt 0 6pt; break-after: avoid; }
h3 { font-size: 11pt; color: #17324d; margin: 12pt 0 4pt; break-after: avoid; }
p { margin: 5pt 0; text-align: justify; }
ul, ol { margin: 4pt 0 6pt 18pt; padding: 0; }
li { margin: 2pt 0; }

/* Tablas */
table { border-collapse: collapse; width: 100%; font-size: 9pt; margin: 8pt 0 12pt; }
th { background: var(--azul); color: #fff; text-align: left; padding: 5px 6px; font-weight: 600; }
td { border: 1px solid var(--borde); padding: 4px 6px; vertical-align: top; }
tr { break-inside: avoid; }
tbody tr:nth-child(even) td { background: #f8fafc; }
td.c, th.c { text-align: center; }

/* Codigo */
code { font-family: Consolas, "Cascadia Mono", monospace; font-size: 9pt; background: #eef1f5; padding: 0 3px; border-radius: 3px; word-break: break-word; }
pre { font: 7.6pt/1.35 Consolas, "Cascadia Mono", monospace; background: var(--fondo); border: 1px solid var(--borde); border-left: 3px solid var(--azul2); padding: 6px 8px; white-space: pre-wrap; word-break: break-word; margin: 4pt 0 10pt; }
pre.cmd { font-size: 8.6pt; }

/* Figuras */
figure { margin: 10pt 0 16pt; break-inside: avoid; }
figure img { display: block; margin: 0 auto; max-width: 100%; max-height: 118mm; width: auto; height: auto; border: 1px solid var(--borde); box-shadow: 0 1px 3px rgba(0,0,0,.12); }
figcaption { font-size: 9.5pt; color: #17324d; margin: 5px 0 2px; }
figcaption .n { font-weight: 700; color: var(--azul); }
.expl { background: var(--fondo); border-left: 3px solid var(--azul2); padding: 3px 10px; margin-top: 4px; }
.expl p { margin: 3pt 0; font-size: 9.5pt; }

/* Marcadores */
.ph { background: #fff176; color: #5a4a00; padding: 0 3px; border-radius: 3px; font-weight: 600; }
.pendiente { border: 2px dashed #d08a00; background: #fff8e1; padding: 8px 12px; margin: 10pt 0 16pt; font-size: 9.5pt; break-inside: avoid; }
.pendiente p { margin: 3pt 0; text-align: left; }
.pendiente .tt { color: var(--alerta); font-weight: 700; font-size: 10.5pt; }
.ok  { color: var(--ok); font-weight: 700; }
.pen { color: var(--alerta); font-weight: 700; }
.nota { border-left: 3px solid var(--alerta); background: #fff8e1; padding: 4px 10px; margin: 8pt 0; font-size: 9.5pt; }
.pri-alta  { color: #a61b1b; font-weight: 700; }
.pri-media { color: var(--alerta); font-weight: 700; }

/* Diagrama */
.diagrama { text-align: center; margin: 8pt 0; }
.diagrama svg { width: 100%; height: auto; max-height: 112mm; }

/* Contenido */
.toc { columns: 2; column-gap: 12mm; font-size: 10.5pt; }
.toc div { margin: 3pt 0; }
